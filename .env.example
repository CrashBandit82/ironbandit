# IronBandit — Environment Configuration
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=ironbandit
POSTGRES_USER=ironbandit
POSTGRES_PASSWORD=changeme

# ── Auth Secrets (generate fresh random values, never reuse across apps) ─────
SECRET_KEY=changeme
REFRESH_SECRET_KEY=changeme

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ── SMTP (registration / password-reset / admin emails) ──────────────────────
# Same provider as Macrobandit, but a separate sender address for IronBandit.
# Leave these EMPTY and the app silently skips sending emails — fill in real
# values once you have them, no code changes needed.
# BITTE AUSFÜLLEN: SMTP-Host deines Providers (z.B. smtp.dein-provider.at)
SMTP_HOST=
SMTP_PORT=587
# BITTE AUSFÜLLEN: SMTP-Login-Benutzername
SMTP_USER=
# BITTE AUSFÜLLEN: SMTP-Login-Passwort
SMTP_PASSWORD=
# BITTE AUSFÜLLEN: sichtbare Absenderadresse, separat vom SMTP_USER-Login (z.B. noreply@ironbandit.at)
SMTP_FROM_ADDRESS=
# BITTE AUSFÜLLEN: Empfänger für Registrierungs-/Feedback-Benachrichtigungen (z.B. trainer@ironbandit.at)
NOTIFY_EMAIL=
