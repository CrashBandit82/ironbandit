# IronBandit - Backend

# Auf Debian-Codename gepinnt (nicht nur "3.11-slim"): das floatende Tag würde
# sonst irgendwann klammheimlich auf eine neue Debian-Version springen. Patches
# innerhalb von 3.11.x/trixie kommen weiterhin automatisch rein.
FROM python:3.11-slim-trixie

WORKDIR /app

# gcc wird nur zum Bauen einzelner Wheels gebraucht und danach wieder entfernt —
# ein Compiler im Laufzeit-Image erleichtert einem Angreifer nach einer RCE das
# Nachladen und Übersetzen weiterer Werkzeuge. Beides muss in EINEM RUN-Schritt
# passieren, sonst bleibt gcc in einem darunterliegenden Layer erhalten.
COPY backend/requirements.txt .
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && pip install --no-cache-dir -r requirements.txt \
 && apt-get purge -y gcc \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

COPY backend/ .

# Nicht als root laufen: bei einer RCE in einer Dependency hätte ein Angreifer
# sonst root im Container inkl. Schreibrechten auf die gemounteten Volumes
# (logs/, uploads/). Feste UID 10001, damit die Host-Bind-Mounts vorab passend
# gechownt werden können.
RUN useradd --create-home --uid 10001 appuser \
 && mkdir -p /var/log/ironbandit /opt/ironbandit/uploads/avatars \
 && chown -R appuser:appuser /var/log/ironbandit /opt/ironbandit/uploads /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
